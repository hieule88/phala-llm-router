# Public HTTPS front for the Leviathan multi-tenant stack.
# Domains come from .env via docker-compose (AUTH_PUBLIC_DOMAIN / EDGE_PUBLIC_DOMAIN).
# Caddy fetches + renews Let's Encrypt certs automatically (needs 80+443 reachable).

# Auth-service: expose ONLY the user payment surface and the NOWPayments IPN.
# Admin (/v1/identities, /v1/topup, /v1/tier, ...) and the metering gate
# (/v1/consume, /v1/refund) stay private on the docker network — the Edge and
# ops reach them internally; the internet gets 404.
{$AUTH_PUBLIC_DOMAIN} {
	@public path /v1/webhooks/nowpayments /v1/payment-intents /v1/payment-intents/* /v1/validate
	handle @public {
		reverse_proxy auth-service:8000
	}
	handle {
		respond 404
	}
}

# The Edge: the full OpenAI-compatible surface is user-facing by design
# (per-key auth + metering happen inside the Edge itself).
{$EDGE_PUBLIC_DOMAIN} {
	reverse_proxy edge:8090
}
