# Public HTTPS front for the Leviathan multi-tenant stack.
# Domains come from .env via docker-compose (AUTH_PUBLIC_DOMAIN / EDGE_PUBLIC_DOMAIN).
# Caddy fetches + renews Let's Encrypt certs automatically (needs 80+443 reachable).

# Auth-service: expose ONLY signup, the user payment surface, and the IPN.
# Admin (/v1/identities, /v1/topup, /v1/tier, ...) and the metering gate
# (/v1/consume, /v1/refund) stay private on the docker network — the Edge and
# ops reach them internally; the internet gets 404.
{$AUTH_PUBLIC_DOMAIN} {
	# Browser dApps poll the intent status (waitForTopup) straight from
	# the auth domain, which is cross-origin for them. The endpoint is
	# public read-only by design (opaque memo, redacted fields), so a
	# wildcard CORS header on the GET is safe — and it is a "simple
	# request" (no custom headers), so no preflight handling is needed.
	@intent_status {
		method GET
		path /v1/payment-intents/*
	}
	handle @intent_status {
		header Access-Control-Allow-Origin "*"
		reverse_proxy auth-service:8000 {
			header_up X-Real-IP {remote_host}
		}
	}
	# Rebuilding an unpaid order's instructions (the SDK's retryCheckout),
	# which a browser dApp needs so a user can return to an order instead
	# of creating another one — pending orders are capped per rail and
	# only an operator can cancel them.
	#
	# Unlike the status GET this is NOT a "simple request": it carries a
	# JSON body, so the browser sends a preflight OPTIONS first. It has to
	# be answered HERE — auth-service mounts no CORS middleware, so the
	# OPTIONS would reach a POST-only route and come back 405 with no
	# Access-Control headers, and the browser would refuse the real call.
	#
	# Wildcard origin is as safe as it is on the status GET: holding a
	# memo only lets you re-ask for instructions, and paying them can
	# still only ever credit the order's original owner. Allow-Headers
	# deliberately lists Content-Type alone, which keeps the admin verbs
	# under this path (mark-paid, cancel — they need Authorization)
	# unreachable from a browser.
	@intent_checkout {
		method POST OPTIONS
		path /v1/payment-intents/*/checkout
	}
	handle @intent_checkout {
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Methods "POST, OPTIONS"
		header Access-Control-Allow-Headers "Content-Type"
		header Access-Control-Max-Age "600"
		route {
			@preflight method OPTIONS
			respond @preflight 204
			reverse_proxy auth-service:8000 {
				header_up X-Real-IP {remote_host}
			}
		}
	}
	@public path /v1/signup /v1/keys/rotate /v1/webhooks/stripe /v1/payment-intents /v1/payment-intents/* /v1/validate
	handle @public {
		reverse_proxy auth-service:8000 {
			# Overwrite, never pass through: a client-supplied X-Real-IP would
			# let a caller mint a fresh rate-limit bucket per request, or pin
			# everyone onto one bucket to lock the service out.
			header_up X-Real-IP {remote_host}
		}
	}
	handle {
		respond 404
	}
}

# The Edge: the full OpenAI-compatible surface is user-facing by design
# (per-key auth + metering happen inside the Edge itself).
{$EDGE_PUBLIC_DOMAIN} {
	# Wallet dApp page (wallet-bound ACI), served on the Edge's OWN origin: the
	# browser needs no CORS, and the origin users approve in the wallet popup
	# is exactly the WALLET_SERVICE_ORIGIN that bind statements must name.
	# 404s harmlessly until docker-compose.wallet.yml mounts the files.
	redir /wallet /wallet/ 308
	handle_path /wallet/* {
		root * /srv/wallet-dapp
		file_server
	}
	handle {
		reverse_proxy edge:8090 {
			header_up X-Real-IP {remote_host}
		}
	}
}
