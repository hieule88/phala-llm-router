# The SDK's node build (0.15.0-node.<sha>, dist-tag "node") lives on the
# private Gitea npm registry, published by
# leviathan-client/crates/web-client/publish-node.sh.
# GITEA_NPM_TOKEN may be empty when the registry allows anonymous read.
@miden-sdk:registry=https://git.softly.com/api/packages/leviathan/npm/
//git.softly.com/api/packages/leviathan/npm/:_authToken=${GITEA_NPM_TOKEN}
