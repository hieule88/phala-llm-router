# Environment for the TEST stack (docker-compose.test.yml).
# Copy to .env.test and fill in. Loaded with `--env-file .env.test`, SEPARATE
# from the production .env — the test stack has its own ledger, secrets, certs.
#
#   cp .env.test.example .env.test    &&    edit .env.test
#
# Generate secret-shaped values with:  openssl rand -hex 32

# ── Test domains (DuckDNS, already pointing at this host) ────────────────────
# Used both as the Caddy site names (HTTPS on :8443) and, for the edge domain,
# as the origin wallet bind statements must carry.
EDGE_PUBLIC_DOMAIN=leviathan-edge-test.duckdns.org
AUTH_PUBLIC_DOMAIN=leviathan-auth-test.duckdns.org

# ── DuckDNS token for the DNS-01 challenge ───────────────────────────────────
# The test Caddy uses this to prove domain control and get a real Let's Encrypt
# cert on port 8443 (no :80/:443 needed). ROTATE the token you pasted in chat
# (duckdns.org → Recreate Token) and put the NEW one here — never commit it.
DUCKDNS_TOKEN=CHANGE_ME_your_rotated_duckdns_token

# ── Test ledger secrets (INDEPENDENT of production) ──────────────────────────
# The test ledger is a fresh empty DB; these are throwaway, unrelated to prod.
ADMIN_TOKEN=CHANGE_ME_test_admin_openssl_rand_hex_32
PROXY_REFUND_TOKEN=CHANGE_ME_test_proxy_openssl_rand_hex_32

# ── Upstream AI gateway ──────────────────────────────────────────────────────
# Faithful: point at the SAME Phala gateway as production (copy the two values
# from the production .env) for real model answers end to end. Test chats then
# consume real upstream compute and create real receipts on the shared gateway,
# but owned by a DIFFERENT tenant bearer (EDGE_TENANT_SECRET below) so they
# never collide with prod.
# Isolated alternative: run a mock and set GATEWAY_URL to it
# (e.g. GATEWAY_URL=http://host.docker.internal:18086 with the verify repo's
# wallet-aci/mock-gateway.py) — no real gateway touched.
GATEWAY_URL=https://your-phala-gateway.example
GATEWAY_API_TOKEN=CHANGE_ME_gateway_internal_api_token

# ── Receipt-owner isolation (IMPORTANT) ──────────────────────────────────────
# MUST differ from the production EDGE_TENANT_SECRET. Receipt ownership is
# HMAC(EDGE_TENANT_SECRET, identity_id); the test ledger reuses low identity ids
# (1, 2, …) that also exist in prod, so a shared secret would collide. A
# distinct secret keeps test receipts separate on the shared gateway.
EDGE_TENANT_SECRET=CHANGE_ME_test_tenant_openssl_rand_hex_32

# ── Wallet-bound ACI (test) ──────────────────────────────────────────────────
# The origin the browser shows for the dApp — MUST match EXACTLY, including the
# :8443 port, or binds are refused "different service".
WALLET_SERVICE_ORIGIN=https://leviathan-edge-test.duckdns.org:8443
EDGE_WALLET_KEY_SECRET=CHANGE_ME_test_wallet_key_openssl_rand_hex_32

# Where the dApp files live (mounted read-only into the test Caddy at /wallet/).
# Point at the verify repo, or `cp -r` its dapp folder to ./wallet-dapp.
WALLET_DAPP_DIR=../../leviathan-ai-gateway-verify/wallet-aci/dapp

# ── Stripe (disabled by default in test) ─────────────────────────────────────
# Empty → checkout returns a soft checkout_error and the webhook answers 404;
# fund test identities via the admin port instead.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
